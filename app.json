{
  "expo": {
    "name": "The Barbershop",
    "slug": "rendez",
    "scheme": "rendez",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131314",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ch.thebarbershop.rendez"
    },
    "android": {
      "package": "ch.thebarbershop.rendez",
      "adaptiveIcon": {
        "backgroundColor": "#131314",
        "foregroundImage": "./assets/app/android-icon-foreground.png",
        "backgroundImage": "./assets/app/android-icon-background.png",
        "monochromeImage": "./assets/app/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/illustrations/ciseaux.png",
          "imageWidth": 120,
          "backgroundColor": "#131314"
        }
      ],
      "expo-sqlite",
      "expo-image",
      [
        "expo-calendar",
        {
          "calendarPermission": "The Barbershop ajoute tes rendez-vous à ton calendrier quand tu le demandes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
